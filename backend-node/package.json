{
  "name": "mailpilot-ai-backend",
  "version": "2.0.0",
  "private": true,
  "description": "MailPilot AI API: sends one individual email per recipient through a configurable provider.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "test": "node --test --test-concurrency=1 test/",
    "migrate": "node scripts/migrate.js",
    "check:provider": "node scripts/check-provider.js",
    "create-user": "node scripts/create-user.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "smtp-server": "^3.21.6",
    "supertest": "^7.3.2"
  }
}
