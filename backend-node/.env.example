# ============================================================
# MailPilot AI — Environment Variables
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3400
API_PREFIX=/api
# Comma-separated list of allowed CORS origins, or * for all.
CORS_ORIGIN=http://localhost:5173
LOG_FORMAT=dev

# --- MailPilot JWT ---
# Strong secret used to sign the MailPilot access JWT returned to the frontend.
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (default 15 minutes).
JWT_EXPIRES_IN=15m

# --- PostgreSQL (local dev) ---
# Either set DATABASE_URL (recommended for Neon/Railway) OR the individual PG* vars.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mailpilot

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must be an AUTHORIZED REDIRECT URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:3400/api/auth/google/callback
# Scopes must include gmail.send to send via the Gmail API.
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/gmail.send

# Frontend URL used to build post-OAuth redirects.
OAUTH_FRONTEND_URL=http://localhost:5173

# --- Token Encryption ---
# 32-byte key encoded as base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# --- SMTP (OPTIONAL fallback provider) ---
# Leave SMTP_HOST empty to disable SMTP entirely (Gmail API only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MailPilot AI

# --- Uploads (temporary only) ---
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_FILES=5
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.csv
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/csv

# --- Email Limits ---
MAX_TO=50
MAX_CC=10
MAX_BCC=10
MAX_SUBJECT_LENGTH=200

