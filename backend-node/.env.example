# MailPilot AI backend configuration. Copy to .env and edit.
# Every value is optional for local demo mode. Placeholders only: never commit real secrets.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3400
# Public URL of the web UI (used for OAuth redirects and as the default CORS origin).
APP_URL=http://localhost:5173
# Comma-separated origins allowed to call the API with cookies. Defaults to APP_URL.
# CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (e.g. 1 behind Nginx/Render/Fly). 0 = none.
TRUST_PROXY=0
# LOG_LEVEL=info

# --- Email provider ---------------------------------------------------------
# demo  = simulate sending, never contacts a mail server (default)
# smtp  = send through the SMTP server below (shared sender for all users)
# gmail = each user signs in with Google and sends from their own Gmail
EMAIL_PROVIDER=demo

# SMTP (EMAIL_PROVIDER=smtp). Examples:
#   Gmail / Workspace: smtp.gmail.com, 587, user = address, pass = an App Password
#                      (NOT your normal Google password; needs 2-Step Verification)
#   Microsoft 365:     smtp.office365.com, 587 (only if your tenant allows SMTP AUTH;
#                      many tenants require OAuth and block password SMTP)
#   Other providers:   use the SMTP host/port/credentials they give you
# Credentials live only in this server-side file and are never sent to the browser.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
# Refuse to send if the server does not offer STARTTLS (ignored when SMTP_SECURE=true).
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# The account's own sender address. Also the sender of system mail such as verification codes.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MailPilot AI
# Other From addresses users may pick on the compose screen: addresses and/or whole
# domains, comma-separated, e.g. alias@example.com,@example.com. Only list addresses
# the SMTP account is really allowed to send as (Gmail "Send mail as" aliases, a
# verified domain at your email service). Anything else is rejected, never spoofed.
# SMTP_ALLOWED_FROM=

# Gmail API via Google OAuth (EMAIL_PROVIDER=gmail). See README "Gmail (OAuth)".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3400/api/auth/google/callback
# 32 random bytes, base64. Encrypts Google tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Storage ----------------------------------------------------------------
# Leave DATABASE_URL empty to use SQLite at SQLITE_PATH (no setup needed).
# Set it to use PostgreSQL, e.g. postgres://user:password@host:5432/mailpilot?sslmode=require
DATABASE_URL=
DATA_DIR=./data
# SQLITE_PATH=./data/mailpilot.db

# --- Accounts & sessions ----------------------------------------------------
# Defaults: open registration in development, closed in production.
# With registration closed, create accounts with: npm run create-user -- you@example.com
# ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=168
# Defaults to true when NODE_ENV=production. Requires HTTPS.
# COOKIE_SECURE=true
# lax (default) | strict | none (none requires COOKIE_SECURE=true; only for cross-site setups)
# COOKIE_SAMESITE=lax

# --- Registration verification (OTP) ----------------------------------------
# New password accounts must enter a code emailed to them (sent through the provider above).
# In demo mode nothing is emailed; the code is shown on screen instead.
# OTP_TTL_SECONDS=120
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_SENDS_PER_HOUR=5

# --- Sending ----------------------------------------------------------------
# Messages sent in parallel, and the minimum gap between starting two sends.
SEND_CONCURRENCY=2
SEND_DELAY_MS=200
# Attempts for temporary failures (SMTP 4xx, HTTP 429/503), with exponential backoff.
SEND_MAX_ATTEMPTS=3
SEND_RETRY_BASE_MS=2000

# --- Limits -----------------------------------------------------------------
MAX_TO=100
MAX_CC=10
MAX_BCC=10
MAX_SUBJECT_LENGTH=200
MAX_BODY_KB=512
MAX_RECIPIENTS_PER_DAY=500
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_TOTAL_MB=15
# How long attachments are kept after a batch with failures, so failed sends can be retried.
ATTACHMENT_RETENTION_HOURS=24

# --- Rate limiting (per IP, except send which is per user) -------------------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1200
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SEND_PER_HOUR=30

# --- Serving the built web UI from this server (single-service deploys) -------
# SERVE_WEB_UI=true
# WEB_DIST_DIR=../web-ui/dist
