# MailPilot web UI configuration (build-time; everything here is PUBLIC).
# Never put secrets in VITE_* variables: they are embedded in the JavaScript bundle.

# Base URL of the API. Default "/api" works for local dev (Vite proxy) and when
# the backend serves the built UI. Set a full URL only for split deployments,
# e.g. https://api.example.com/api (then configure CORS_ORIGINS and cookies on the backend).
VITE_API_BASE_URL=/api

# Dev only: where the Vite dev server forwards /api requests.
DEV_API_PROXY_TARGET=http://localhost:3400
